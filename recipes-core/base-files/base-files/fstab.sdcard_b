#/dev/disk/by-partuuid/d168dbce-65f3-423c-86af-a11528890b30      /vendor               ext4       defaults,sync         0  1
#/dev/disk/by-partuuid/7e036063-979d-4000-949d-33ab3e987de0      /usr/local            ext4       defaults,sync         0  1
