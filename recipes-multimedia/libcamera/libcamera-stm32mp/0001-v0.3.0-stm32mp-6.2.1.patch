+ */
+
+#include "luminance_utils.h"
+
+namespace libcamera {
+
+namespace ipa::dcmipp::algorithms {
+
+int32_t luminanceFromRgb(const uint32_t RGB[3])
+{
+	return static_cast<int32_t>((3 * RGB[0] + 6 * RGB[1] + RGB[2]) / 10);
+}
+
+int32_t luminanceFromRgbMono(const uint32_t RGB[3])
+{
+	return static_cast<int32_t>(RGB[0] + RGB[1] + RGB[2]);
+}
