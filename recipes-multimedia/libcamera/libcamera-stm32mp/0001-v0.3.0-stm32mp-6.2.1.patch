+	IPA_MODULE_API_VERSION,
+	0,
+	"dcmipp",
+	"dcmipp",
+};
+
+IPAInterface *ipaCreate()
+{
+	LOG(IPADcmipp, Debug) << __func__;
+
+	return new ipa::dcmipp::IPADcmipp();
+}
+}
