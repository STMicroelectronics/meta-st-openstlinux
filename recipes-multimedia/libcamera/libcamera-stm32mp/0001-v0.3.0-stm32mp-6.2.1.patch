+	formats::VYUY,
+	formats::R8,
+	formats::SBGGR8,
+	formats::SGBRG8,
+	formats::SGRBG8,
+	formats::SRGGB8,
+	formats::SBGGR10,
+	formats::SGBRG10,
+	formats::SGRBG10,
+	formats::SRGGB10,
+	formats::SBGGR12,
+	formats::SGBRG12,
+	formats::SGRBG12,
+	formats::SRGGB12,
+	formats::SBGGR14,
+	formats::SGBRG14,
+	formats::SGRBG14,
+	formats::SRGGB14,
+	formats::MJPEG,
+};
+
+constexpr std::array<PixelFormat, 14> pixelformats_main{
+	formats::RGB565,
+	formats::YUYV,
+	formats::YVYU,
+	formats::UYVY,
+	formats::VYUY,
+	formats::R8,
+	formats::RGB888,
+	formats::BGR888,
+	formats::NV12,
+	formats::NV21,
+	formats::NV16,
+	formats::NV61,
+	formats::YUV420,
+	formats::YVU420,
+};
+
+/*
+ * Since we only concentrate on RAW input and AUX doesn't have
+ * RGB to YUV conversion, AUX will only output RGB formats
+ * until we also add support for non-raw sensors.
+ */
+constexpr std::array<PixelFormat, 3> pixelformats_aux{
+	formats::RGB565,
+	formats::RGB888,
+	formats::BGR888,
+};
