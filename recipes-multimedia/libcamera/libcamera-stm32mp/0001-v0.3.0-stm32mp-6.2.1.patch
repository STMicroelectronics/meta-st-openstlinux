+	{ formats::R8, MEDIA_BUS_FMT_Y8_1X8 },
+	{ formats::R10, MEDIA_BUS_FMT_Y10_1X10 },
+	{ formats::R12, MEDIA_BUS_FMT_Y12_1X12 },
+	/* R14 is not available in libcamera formats */
+	/* { formats::R14, MEDIA_BUS_FMT_Y14_1X14 }, */
+	/* Compressed */
+	{ formats::MJPEG, MEDIA_BUS_FMT_JPEG_1X8 },
+};
