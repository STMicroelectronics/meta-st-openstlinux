+struct close_data
+{
+  GstPromise *promise;
+  gboolean agent_closed;
+};
+
+static struct close_data *
+close_data_new (GstPromise * promise)
+{
+  struct close_data *data = g_new0 (struct close_data, 1);
+
+  data->promise = promise ? gst_promise_ref (promise) : NULL;
+  return data;
+}
+
+static void
+close_data_free (struct close_data *data)
+{
+  if (data->promise)
+    gst_promise_unref (data->promise);
+  g_free (data);
+}
+
+static void
+on_agent_closed (GObject * source, GAsyncResult * result, gpointer user_data)
+{
+  struct close_data *data = user_data;
+
+  if (data->promise)
+    gst_promise_reply (data->promise, NULL);
+  data->agent_closed = TRUE;
+}
+
+static gboolean
+on_agent_close_timeout (gpointer user_data)
+{
+  gboolean *timed_out = user_data;
+
+  *timed_out = TRUE;
+  return G_SOURCE_REMOVE;
+}
+
+static void
+close_agent (GstWebRTCNice * ice, GstPromise * promise)
+{
+  GMainContext *context;
+  struct close_data *data;
+  gboolean timed_out = FALSE;
+  GSource *timeout_source;
+
+  if (!ice->priv->thread) {
+    if (promise) {
+      GError *error =
+          g_error_new (GST_WEBRTC_ERROR, GST_WEBRTC_ERROR_INTERNAL_FAILURE,
+          "ICE thread not running");
+      GstStructure *reply = gst_structure_new ("application/x-gst-promise",
+          "error", G_TYPE_ERROR, error, NULL);
+
+      gst_promise_reply (promise, reply);
+      g_clear_error (&error);
+    }
+    return;
+  }
+
+  g_cancellable_cancel (ice->priv->resolve_cancellable);
+
+  context = g_main_context_new ();
+  g_main_context_push_thread_default (context);
+  timeout_source = g_timeout_source_new (MAX_CLOSING_TIME_MILLI_SECONDS);
+  g_source_set_callback (timeout_source, on_agent_close_timeout,
+      &timed_out, NULL);
+  g_source_attach (timeout_source, context);
+
+  data = close_data_new (promise);
+  nice_agent_close_async (ice->priv->nice_agent, on_agent_closed, data);
+  while (!data->agent_closed && !timed_out)
+    g_main_context_iteration (context, TRUE);
+
+  if (timed_out)
+    GST_WARNING_OBJECT (ice, "nice_agent_close_async() did not finish");
+
+  g_source_destroy (timeout_source);
+  g_source_unref (timeout_source);
+  g_main_context_pop_thread_default (context);
+  g_main_context_unref (context);
+  close_data_free (data);
+
+  outstanding_resolves_wait (ice->priv->outstanding_resolves);
+  _stop_thread (ice);
+}
+
+static void
+gst_webrtc_nice_close (GstWebRTCICE * ice, GstPromise * promise)
+{
+  close_agent (GST_WEBRTC_NICE (ice), promise);
+}
+
