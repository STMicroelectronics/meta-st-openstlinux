+static OutstandingResolves *
+outstanding_resolves_ref (OutstandingResolves * resolves)
+{
+  return g_atomic_rc_box_acquire (resolves);
+}
+
+static void
+outstanding_resolves_free (OutstandingResolves * resolves)
+{
+  g_cond_clear (&resolves->cond);
+  g_mutex_clear (&resolves->mutex);
+}
+
+static void
+outstanding_resolves_unref (OutstandingResolves * resolves)
+{
+  g_atomic_rc_box_release_full (resolves,
+      (GDestroyNotify) outstanding_resolves_free);
+}
+
+static void
+outstanding_resolves_dec (OutstandingResolves * resolves)
+{
+  g_mutex_lock (&resolves->mutex);
+  resolves->count--;
+  if (resolves->count == 0)
+    g_cond_signal (&resolves->cond);
+  g_mutex_unlock (&resolves->mutex);
+}
+
+static gboolean
+outstanding_resolves_try_inc (OutstandingResolves * resolves)
+{
+  gboolean ret = FALSE;
+
+  g_mutex_lock (&resolves->mutex);
+  if (!resolves->cancelled) {
+    resolves->count++;
+    ret = TRUE;
+  }
+  g_mutex_unlock (&resolves->mutex);
+
+  return ret;
+}
+
+static void
+outstanding_resolves_wait (OutstandingResolves * resolves)
+{
+  g_mutex_lock (&resolves->mutex);
+  resolves->cancelled = TRUE;
+  while (resolves->count != 0)
+    g_cond_wait (&resolves->cond, &resolves->mutex);
+  g_mutex_unlock (&resolves->mutex);
+}
