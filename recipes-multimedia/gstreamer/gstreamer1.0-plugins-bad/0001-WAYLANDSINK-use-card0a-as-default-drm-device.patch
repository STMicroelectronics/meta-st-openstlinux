From: Christophe Priouzeau <christophe.priouzeau@foss.st.com>
Date: Fri, 10 Apr 2026 15:44:41 +0200
Subject: [PATCH 01/22] WAYLANDSINK: use card0a as default drm-device

Signed-off-by: Christophe Priouzeau <christophe.priouzeau@foss.st.com>
Upstream-Status: Pending
---
 ext/wayland/gstwaylandsink.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/ext/wayland/gstwaylandsink.c b/ext/wayland/gstwaylandsink.c
index 443db24..1fa276e 100644
--- a/ext/wayland/gstwaylandsink.c
+++ b/ext/wayland/gstwaylandsink.c
@@ -196,7 +196,7 @@ gst_wayland_sink_class_init (GstWaylandSinkClass * klass)
   g_object_class_install_property (gobject_class, PROP_DRM_DEVICE,
       g_param_spec_string ("drm-device", "DRM Device", "Path of the "
           "DRM device to use for dumb buffer allocation",
-          NULL,
+          "/dev/dri/card0",
           G_PARAM_READWRITE | G_PARAM_STATIC_STRINGS | G_PARAM_CONSTRUCT_ONLY));
 
  /**
